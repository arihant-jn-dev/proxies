# PROXY_PORT - Port for the proxy server
PROXY_PORT=8080

# BACKEND_URL - Default backend server URL for reverse proxies
BACKEND_URL=http://localhost:3000

# LOG_LEVEL - Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# CACHE_ENABLED - Enable caching in HTTP proxies
CACHE_ENABLED=true

# CACHE_SIZE_MB - Cache size in megabytes
CACHE_SIZE_MB=100

# CACHE_TTL_SECONDS - Default cache TTL in seconds
CACHE_TTL_SECONDS=300

# AUTH_ENABLED - Enable authentication
AUTH_ENABLED=false

# AUTH_USERS - Comma-separated list of username:password pairs
AUTH_USERS=admin:password,user:userpass

# SOCKS_PORT - Port for SOCKS proxy
SOCKS_PORT=1080

# SOCKS_AUTH_ENABLED - Enable SOCKS authentication
SOCKS_AUTH_ENABLED=false

# SOCKS_UDP_ENABLED - Enable SOCKS UDP relay
SOCKS_UDP_ENABLED=true

# SSL_ENABLED - Enable SSL/TLS
SSL_ENABLED=false

# SSL_CERT_FILE - Path to SSL certificate file
SSL_CERT_FILE=cert.pem

# SSL_KEY_FILE - Path to SSL private key file
SSL_KEY_FILE=key.pem

# MAX_CONNECTIONS - Maximum concurrent connections
MAX_CONNECTIONS=1000

# CONNECTION_TIMEOUT - Connection timeout in seconds
CONNECTION_TIMEOUT=30

# RATE_LIMIT_ENABLED - Enable rate limiting
RATE_LIMIT_ENABLED=false

# RATE_LIMIT_REQUESTS - Max requests per window
RATE_LIMIT_REQUESTS=100

# RATE_LIMIT_WINDOW - Rate limit window in seconds
RATE_LIMIT_WINDOW=60
