{
  "bind_host": "0.0.0.0",
  "bind_port": 8080,
  "log_level": "INFO",
  "max_connections": 100,
  "timeout_seconds": 30,
  
  "backend_servers": [
    "http://localhost:3000",
    "http://localhost:3001",
    "http://localhost:3002"
  ],
  
  "load_balancer_algorithm": "round_robin",
  
  "health_check_enabled": true,
  "health_check_interval": 30,
  "health_check_path": "/health",
  
  "rate_limit_enabled": false,
  "rate_limit_requests": 100,
  "rate_limit_window": 60,
  
  "cache_enabled": true,
  "cache_ttl_seconds": 300,
  "cache_max_size": "100MB",
  
  "ssl_enabled": false,
  "ssl_cert_file": "cert.pem",
  "ssl_key_file": "key.pem",
  
  "add_headers": {
    "X-Proxy": "HTTPProxy/1.0",
    "X-Request-ID": "auto-generated"
  },
  
  "remove_headers": [
    "Server",
    "X-Powered-By"
  ],
  
  "blocked_domains": [
    "malware.example.com",
    "phishing.example.com"
  ],
  
  "blocked_keywords": [
    "malware",
    "virus",
    "phishing"
  ],
  
  "auth_enabled": false,
  "auth_users": {
    "admin": "secure_password",
    "user": "user_password"
  }
}
